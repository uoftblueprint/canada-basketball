<% content_for :title, @game.name %>
<section class="w-full px-5 py-5" aria-labelledby="game-heading">
  <nav class="breadcrumbs mb-2 py-0 text-xs uppercase [&_li+li]:before:hidden" aria-label="<%= t(".breadcrumbs") %>">
    <ol>
      <li>
        <% if logged_in_as_admin? %>
          <%= link_to t(".camps"), camps_path, class: "link link-primary" %>
        <% else %>
          <%= t(".camps") %>
        <% end %>
      </li>
      <li>
        <span class="mx-1" aria-hidden="true">/</span>
        <%= link_to current_camp.name, camp_path(current_camp), class: "link" %>
      </li>
      <li>
        <span class="mx-1" aria-hidden="true">/</span>
        <%= link_to t(".games"), camp_path(current_camp, anchor: "games-heading"), class: "link link-primary" %>
      </li>
      <li aria-current="page">
        <span class="mx-1" aria-hidden="true">/</span>
        <%= @game.name %>
      </li>
    </ol>
  </nav>
  <header>
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <h1 id="game-heading" class="min-w-0 break-words text-3xl font-bold"><%= @game.name %></h1>
      <div class="flex shrink-0 flex-wrap items-center gap-2">
        <%= render ActionButtonComponent.new(
              to: edit_camp_game_path(current_camp, @game),
              icon: "pencil",
              color: :primary,
              turbo_stream: true,
              size: :medium
            ) do %>
          <%= t(".edit_game") %>
        <% end %>
        <%= render ActionButtonComponent.new(
              to: camp_game_path(current_camp, @game),
              icon: "trash",
              color: :primary,
              method: :delete,
              size: :medium
            ) do %>
          <%= t(".delete_game") %>
        <% end %>
      </div>
    </div>
    <h2 class="mt-4 border-b border-base-300 pb-1 text-2xl font-semibold break-words">
      <%= t(".matchup", team: @game.team.name, opponent: @game.opponent_name) %>
    </h2>
  </header>
</section>
