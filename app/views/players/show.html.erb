<section class="w-full px-6 py-4" aria-labelledby="player-details-heading">
  <div class="mx-auto max-w-7xl">
    <nav class="breadcrumbs text-sm uppercase" aria-label="Breadcrumb">
      <ul>
        <li><%= link_to Player.model_name.human(count: 2), players_path, class: "link link-primary" %></li>
        <li><%= @player.name %></li>
      </ul>
    </nav>

    <h1 id="player-details-heading" class="mb-6 text-4xl font-bold"><%= t("players.show.title") %></h1>
    <%= render Players::DetailsComponent.new(player: @player) %>
  </div>
</section>
