<div class="px-6 py-4">
  <nav class="breadcrumbs text-sm" aria-label="<%= t(".title") %>">
    <ul>
      <li aria-current="page"><%= t(".title") %></li>
    </ul>
  </nav>
  <header class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <h1 class="text-4xl font-bold"><%= t(".title") %></h1>
    <%= render ActionButtonComponent.new(
          to: new_player_path,
          icon: "plus",
          color: :primary,
          size: :medium,
          turbo_stream: true
        ) do %>
      <%= t(".create_player") %>
    <% end %>
  </header>
  <%= render Shared::IndexTableComponent.new(
        state: @table_state,
        path_builder: ->(params) { players_path(params) }
      ) do |table| %>
    <% table.column :name %>
    <% table.column :actions, header: t("shared.index_table_component.actions"), col_size: "auto", fill: true do |player| %>
      <div class="flex h-full" role="group" aria-label="<%= t("shared.index_table_component.actions") %>">
        <%= render ActionButtonComponent.new(
              to: player_path(player),
              icon: "eye",
              color: :base,
              size: :large,
              turbo_stream: true
            ) do %>
          <%= t("shared.index_table_component.view") %>
        <% end %>
        <%= render ActionButtonComponent.new(
              to: edit_player_path(player),
              icon: "pencil",
              color: :neutral,
              size: :large,
              turbo_stream: true
            ) do %>
          <%= t("shared.index_table_component.edit") %>
        <% end %>
        <%= render ActionButtonComponent.new(
              to: player_path(player),
              icon: "trash",
              color: :primary,
              method: :delete,
              size: :large,
              confirm: t("players.index.delete_confirmation", name: player.name)
            ) do %>
          <%= t("shared.index_table_component.delete") %>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>
