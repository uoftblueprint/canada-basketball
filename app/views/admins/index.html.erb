<div>
  <h1 class="font-bold text-4xl">Admins</h1>
  <table>
    <thead>
      <tr>
        <th>Name</th>
        <th>Email</th>
      </tr>
    </thead>
    <tbody>
      <% @admins.each do |admin| %>
        <tr>
          <td><%= admin.name %></td>
          <td><%= admin.email %></td>
          <td><%= button_to "Delete", admin_path(admin), method: :delete %></td>
          <td><%= button_to "Delete", admin_path(admin), method: :delete %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
