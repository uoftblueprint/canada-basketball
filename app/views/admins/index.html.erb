<div class="px-6 py-8">
  <header class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <h1 class="text-4xl font-bold"><%= t(".title") %></h1>
    <%= render ActionButtonComponent.new(
          to: new_admin_path,
          icon: "plus",
          color: :primary,
          size: :medium,
          turbo_stream: true
        ) do %>
      <%= t(".create_admin") %>
    <% end %>
  </header>
  <%= render Shared::IndexTableComponent.new(
        state: @table_state,
        path_builder: ->(params) { admins_path(params) }
      ) do |table| %>
    <% table.column :name %>
    <% table.column :email %>
    <% table.column :actions, header: t("shared.index_table_component.actions"), col_size: "auto", fill: true do |admin| %>
      <div class="flex h-full" role="group" aria-label="<%= t("shared.index_table_component.actions") %>">
        <%= render ActionButtonComponent.new(
              to: edit_admin_path(admin),
              icon: "pencil",
              color: :neutral,
              size: :large,
              turbo_stream: true
            ) do %>
          <%= t("shared.index_table_component.edit") %>
        <% end %>
        <%= render ActionButtonComponent.new(
              to: admin_path(admin),
              icon: "trash",
              color: :primary,
              method: :delete,
              size: :large,
              confirm: t("admins.index.delete_confirmation", name: admin.name)
            ) do %>
          <%= t("shared.index_table_component.delete") %>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>
