<div class="px-6 py-8">
  <header class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h1 class="text-4xl font-bold"><%= t(".title") %></h1>
      <p class="mt-2 text-base-content/70"><%= t(".subtitle") %></p>
    </div>

    <%= render ActionButtonComponent.new(
          to: new_admin_path,
          icon: "plus",
          color: :primary,
          size: :medium,
          turbo_stream: true
        ) do %>
      <%= t(".create_admin") %>
    <% end %>
  </header>
  <%= render Shared::IndexTableComponent.new(
        state: @table_state,
        path_builder: ->(params) { admins_path(params) }
      ) do |table| %>
    <% table.column :name %>
    <% table.column :email %>

    <% table.column :actions, header: t("shared.index_table_component.actions"), col_size: "auto" do |admin| %>
      <div class="flex items-center gap-2">
        <%= render ActionButtonComponent.new(
              to: edit_admin_path(admin),
              icon: "pencil",
              color: :neutral,
              size: :medium,
              turbo_stream: true
            ) do %>
          <%= t("admins.index.actions.edit") %>
        <% end %>

        <%= render ActionButtonComponent.new(
              to: admin_path(admin),
              icon: "trash",
              color: :primary,
              method: :delete,
              size: :medium,
              confirm: t("admins.index.actions.delete_confirmation", name: admin.name)
            ) do %>
          <%= t("admins.index.actions.delete") %>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>
