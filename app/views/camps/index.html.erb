<div>
  <h1 class="font-bold text-4xl">Camps</h1>
  <table>
    <thead>
      <tr>
        <th>Name</th>
        <th>Description</th>
        <th>Status</th>
      </tr>
    </thead>
    <tbody>
      <% @camps.each do |camp| %>
        <tr>
          <td><%= camp.name %></td>
          <td><%= camp.description %></td>
          <td><%= camp.active? ? "Active" : "Inactive" %></td>
          <td><%= button_to "Delete", camp_path(camp), method: :delete %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
