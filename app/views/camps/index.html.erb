<% content_for :title, t(".page_title") %>
<div class="px-6 py-4">
  <div class="mx-auto max-w-7xl">
    <nav class="breadcrumbs text-sm uppercase" aria-label="Breadcrumb">
      <ul>
        <li><%= Camp.model_name.human(count: 2) %></li>
      </ul>
    </nav>

    <div class="mb-6 flex items-center justify-between">
      <h1 id="camps-heading" class="text-4xl font-bold"><%= t("camps.index.title") %></h1>

      <%= render ActionButtonComponent.new(
            to: new_camp_path,
            icon: "plus",
            color: :primary,
            size: :large,
            turbo_stream: true
          ) do %>
        <%= t("camps.index.add_camp") %>
      <% end %>
    </div>

    <%= render Shared::IndexCardsComponent.new(
          state: @table_state,
          path_builder: ->(params) { camps_path(params) },
          listings_label: t("camps.index.listings_label"),
          pagination_label: t("camps.index.pagination_label")
        ) do |cards| %>
      <% cards.card do |camp| %>
        <%= render Camps::CardComponent.new(camp: camp) %>
      <% end %>
    <% end %>
  </div>
</div>
