<% content_for :title, t(".title") %>
<div class="flex min-h-screen items-center justify-center p-4">
  <section class="card w-full max-w-md border border-base-300 bg-base-100" aria-labelledby="login-heading">
    <%= render "tabs" %>
    <div class="card-body gap-0 p-10">
      <h1 id="login-heading" class="mb-8 text-3xl font-semibold"><%= t(".title") %></h1>
      <%= form_with url: login_admin_path do |form| %>
        <div class="mb-6">
          <%= form.label :email, t(".email") %>
          <%= form.email_field :email, required: true, autocomplete: "email" %>
        </div>
        <div class="mb-12">
          <%= form.label :password, t(".password") %>
          <%= form.password_field :password, required: true, autocomplete: "current-password" %>
        </div>
        <%= form.submit t(".submit") %>
      <% end %>
    </div>
  </section>
</div>
