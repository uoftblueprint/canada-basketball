<div>
  <h1 class="font-bold text-4xl">Admin Login</h1>

  <%= form_with url: login_admin_path do |form| %>
    <div>
      <%= form.label :email %>
      <%= form.text_field :email, required: true, placeholder: "Email" %>
    </div>
    <div>
      <%= form.label :password %>
      <%= form.password_field :password, required: true, placeholder: "Password" %>
    </div>
    <%= form.submit "Login" %>
  <% end %>
</div>
