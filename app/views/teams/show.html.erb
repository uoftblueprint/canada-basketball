<section class="w-full px-6 py-4" aria-labelledby="team-details-heading">
  <div class="mx-auto max-w-7xl">
    <nav class="breadcrumbs text-sm uppercase" aria-label="Breadcrumb">
      <ul>
        <li>
          <% if logged_in_as_admin? %>
            <%= link_to Camp.model_name.human(count: 2), camps_path, class: "link link-primary" %>
          <% else %>
            <%= Camp.model_name.human(count: 2) %>
          <% end %>
        </li>
        <li><%= link_to current_camp.name, camp_path(current_camp), class: "link link-primary" %></li>
        <li><%= @team.name %></li>
      </ul>
    </nav>

    <h1 id="team-details-heading" class="mb-6 text-4xl font-bold"><%= t("teams.show.title") %></h1>

    <%= render Teams::PlayerListComponent.new(team: @team) %>
  </div>
</section>
