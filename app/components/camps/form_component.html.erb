<%= form_with model: camp, html: { autocomplete: "off" }, class: "flex flex-col gap-8" do |form| %>
  <div class="flex flex-col gap-2">
      <fieldset class="fieldset">
        <%= form.label :name %>
        <%= form.text_field :name, required: true %>
      </fieldset>
      <fieldset class="fieldset">
        <%= form.label :description %>
        <%= form.textarea :description, required: true %>
      </fieldset>
      <%= form.multiple_search_select :player_ids, :id, :name %>
      <fieldset class="flex flex-row justify-between">
        <%= form.label :active %>
        <%= form.checkbox :active %>
      </fieldset>
      <fieldset class="fieldset">
        <%= form.label :password %>
        <%= form.password_field :password,
                                required: camp.new_record?,
                                autocomplete: "new-password",
                                aria: { describedby: ("camp_password_hint" if camp.persisted?) } %>
        <% if camp.persisted? %>
          <p id="camp_password_hint" class="label text-sm text-base-content/60">
            <%= t(".password_hint") %>
          </p>
        <% end %>
      </fieldset>
      <fieldset class="fieldset">
        <%= form.label :password_confirmation %>
        <%= form.password_field :password_confirmation, required: camp.new_record?, autocomplete: "new-password" %>
      </fieldset>
  </div>
  <%= form.submit %>
<% end %>
