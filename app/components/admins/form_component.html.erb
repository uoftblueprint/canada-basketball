<%= form_with model: admin, class: "flex flex-col gap-8" do |f| %>
  <div class="flex flex-col gap-2">
    <fieldset class="fieldset">
      <%= f.label :email %>
      <%= f.email_field :email, autocomplete: "email", aria: { invalid: admin.errors[:email].any? } %>
    </fieldset>
    <fieldset class="fieldset">
      <%= f.label :name %>
      <%= f.text_field :name, autocomplete: "name", aria: { invalid: admin.errors[:name].any? } %>
    </fieldset>
    <fieldset class="fieldset">
      <%= f.label :password %>
      <%= f.password_field :password,
                           autocomplete: "new-password",
                           aria: {
                             invalid: admin.errors[:password].any?,
                             describedby: ("admin_password_hint" if admin.persisted?)
                           } %>
      <% if admin.persisted? %>
        <p id="admin_password_hint" class="label text-sm text-base-content/60">
          <%= t(".password_hint") %>
        </p>
      <% end %>
    </fieldset>
    <fieldset class="fieldset">
      <%= f.label :password_confirmation %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", aria: { invalid: admin.errors[:password_confirmation].any? } %>
    </fieldset>
  </div>
  <%= f.submit %>
<% end %>
