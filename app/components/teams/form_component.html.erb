<%= form_with model: [camp, team], html: { autocomplete: "off" } do |f| %>
  <div>
    <%= f.label :name %>
    <%= f.text_field :name %>
  </div>

  <fieldset>
    <legend>Players</legend>
    <%= f.collection_check_boxes :player_ids, players, :id, :name do |b| %>
      <div><%= b.check_box %> <%= b.label { "#{b.object.name} (#{team_label(b.object)})" } %></div>
    <% end %>
  </fieldset>

  <%= f.submit %>
<% end %>
