<aside class="sticky top-0 flex flex-col h-screen w-64 bg-base-100 border-r border-base-300">
  <%= link_to root_path, class: "block bg-primary text-primary-content px-8 pt-14 pb-6",
                         aria: { label: t(".home_link") } do %>
    <span class="block font-bold text-xl uppercase leading-tight" aria-hidden="true">
      <%= t(".brand_line_1") %><br><%= t(".brand_line_2") %>
    </span>
  <% end %>

  <nav aria-label="<%= t(".nav_label") %>" class="flex-1 overflow-y-auto">
    <ul class="menu w-full p-0 py-2">
      <% sections.flat_map(&:items).each do |item| %>
        <% active = active?(item) %>
        <li>
          <%= link_to item.path,
                      class: class_names(
                        "gap-4 px-8 py-3 text-base hover:bg-base-200 active:bg-base-200! active:text-base-content! active:shadow-none!",
                        "font-bold bg-transparent! text-base-content! shadow-none!" => active
                      ),
                      aria: { current: (active ? "page" : nil) } do %>
            <%= render Shared::IconComponent.new(icon: item.icon, size: :sm) %>
            <span><%= item.name %></span>
          <% end %>
        </li>
      <% end %>
    </ul>
  </nav>

  <div class="bg-base-200 border-t border-base-300">
    <ul class="menu w-full p-0 py-2">
      <li>
        <%= button_to logout_item.path, method: :delete, form_class: "w-full",
                                        class: "flex w-full items-center gap-4 px-8 py-3 text-base font-bold hover:bg-base-300/40 active:bg-base-300/40! active:text-base-content! active:shadow-none!" do %>
          <%= render Shared::IconComponent.new(icon: logout_item.icon, size: :sm) %>
          <span><%= logout_item.name %></span>
        <% end %>
      </li>
    </ul>
  </div>
</aside>
