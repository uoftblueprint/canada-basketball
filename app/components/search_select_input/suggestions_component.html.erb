<%= turbo_frame_tag frame_id do %>
  <ul role="listbox" class="menu bg-base-100 rounded-lg w-full p-1 max-h-64 overflow-y-auto">
    <% if records.empty? %>
      <li class="px-4 py-2 text-base-content/50" aria-disabled="true">No matches</li>
    <% else %>
      <% records.each do |record| %>
        <li>
          <button
            type="button"
            role="option"
            id="<%= "#{frame_id}-option-#{value_for(record)}" %>"
            class="flex justify-between <%= "opacity-50" if selected?(record) %>"
            data-search-select-target="option"
            data-id="<%= value_for(record) %>"
            data-label="<%= text_for(record) %>"
            data-action="click->search-select#select mouseenter->search-select#highlight"
            aria-selected="false"
            aria-disabled="<%= selected?(record) %>"
            <%= "disabled" if selected?(record) %>>
            <span><%= text_for(record) %></span>
            <% if selected?(record) %>
              <%= render Shared::IconComponent.new(icon: "check", size: :sm) %>
            <% end %>
          </button>
        </li>
      <% end %>
    <% end %>
  </ul>
<% end %>
