<%= turbo_frame_tag frame_id do %>
  <ul role="listbox" class="menu flex-nowrap bg-base-100 w-full p-1 max-h-64 overflow-y-auto">
    <% if records.empty? %>
      <li class="px-4 py-2 text-base-content/50" aria-disabled="true">No matches</li>
    <% else %>
      <% records.each do |record| %>
        <li>
          <button
            type="button"
            role="option"
            id="<%= "#{frame_id}-option-#{value_for(record)}" %>"
            class="flex justify-between"
            data-search-select-target="option"
            data-id="<%= value_for(record) %>"
            data-label="<%= text_for(record) %>"
            data-action="click->search-select#select mouseenter->search-select#highlight"
            aria-selected="false">
            <span><%= text_for(record) %></span>
            <span data-check class="<%= "hidden" unless selected?(record) %>">
              <%= render Shared::IconComponent.new(icon: "check", size: :sm) %>
            </span>
          </button>
        </li>
      <% end %>
    <% end %>
  </ul>
<% end %>
