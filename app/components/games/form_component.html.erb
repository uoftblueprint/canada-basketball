<%= form_with model: [camp, game] do |form| %>
  <div class="flex flex-col gap-3">

    <div class="flex flex-col">
      <%= form.label :name %>
      <%= form.text_field :name, required: true, autocomplete: "off", class: "input" %>
    </div>

    <div class="flex flex-col">
      <%= form.label :team_id, "Team" %>
      <%= form.collection_select :team_id, camp.teams, :id, :name, { include_blank: true }, class: "select" %>
    </div>

    <div class="flex flex-col">
      <%= form.label :opponent_name %>
      <%= form.text_field :opponent_name, required: true, autocomplete: "off", class: "input" %>
    </div>

    <div>
      <%= form.label :active, "Active" %>
      <%= form.check_box :active, class: "checkbox checkbox-primary" %>
    </div>

    <div>
      <%= form.submit(game.persisted? ? "Update Game" : "Create Game", class: "btn btn-primary") %>
    </div>
  </div>
<% end %>
