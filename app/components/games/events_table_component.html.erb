<div id="<%= table_id %>" class="overflow-x-auto text-xs">
  <%= render Shared::IndexTableComponent.new(state:, path_builder:, csv_path_builder:, searchable: false) do |table| %>
    <% table.column :created_at do |event| %>
      <%= l(event.created_at) %>
    <% end %>
    <% table.column :period do |event| %>
      <%= t("game_events.periods.#{event.period}") %>
    <% end %>
    <% table.column :kind, col_size: "2fr" do |event| %>
      <%= t("game_events.kinds.#{event.kind}") %>
    <% end %>
    <% table.column :player, col_size: "2fr" do |event| %>
      <%= event.player&.name %>
    <% end %>
    <% table.column :team, col_size: "2fr" do |event| %>
      <%= event.is_opponent? ? game.opponent_name : game.team.name %>
    <% end %>
    <% if show_actions? %>
      <% table.column :actions, header: t("shared.index_table_component.actions"), col_size: "auto", fill: true do |event| %>
        <%= render ActionButtonComponent.new(
              to: delete_path_builder.call(event),
              icon: :trash,
              color: :primary,
              method: :delete,
              size: :medium
            ) do %>
          <%= t("shared.index_table_component.delete") %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>
