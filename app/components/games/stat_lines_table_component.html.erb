<div class="overflow-x-auto text-xs">
  <%= render Shared::IndexTableComponent.new(state:, path_builder:, searchable: false) do |table| %>
    <% table.column :player, col_size: "2fr" do |line| %>
      <%= name_for(line) %>
    <% end %>
    <% STAT_COLUMNS.each do |column| %>
      <% table.column column, header: t("game_events.abbreviations.#{column}") do |line| %>
        <%= format_stat(line, column) %>
      <% end %>
    <% end %>
  <% end %>
</div>
