<section class="mt-6 min-w-0" aria-labelledby="team-stats-heading">
  <h2 id="team-stats-heading" class="mb-4 border-b pb-2 text-3xl font-semibold">
    <%= t("games.team_stats") %>
  </h2>

  <div class="overflow-x-auto text-xs">
    <table class="w-full border-collapse whitespace-nowrap">
      <thead class="bg-base-200">
        <tr>
          <th scope="col" class="border px-3 py-2 text-left">
            <%= Game.human_attribute_name(:team) %>
          </th>
          <% STAT_COLUMNS.each do |column| %>
            <th scope="col" class="border px-3 py-2 text-right">
              <%= t("game_events.abbreviations.#{column}") %>
            </th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% rows.each do |row| %>
          <tr>
            <th scope="row" class="border px-3 py-2 text-left font-normal">
              <%= row.fetch(:name) %>
            </th>
            <% STAT_COLUMNS.each do |column| %>
              <td class="border px-3 py-2 text-right">
                <%= format_stat(row.fetch(:stats), column) %>
              </td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
