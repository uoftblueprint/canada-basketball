<div id="modal"
     class="fixed inset-0 z-50 bg-black/40 backdrop-blur-sm flex items-center justify-center hidden"
     data-controller="modal"
     data-action="turbo:submit-end->modal#close click->modal#closeBackground keydown.esc@window->modal#close">
  <div
    class="card bg-base-100 border border-base-300 rounded-xl shadow-xl w-full max-w-xl p-6 max-h-[90vh] flex flex-col"
    role="dialog"
    aria-modal="true"
    aria-labelledby="modal_title">
    <div class="flex items-center justify-between">
      <h2 id="modal_title" class="text-lg font-semibold"><%= title %></h2>
      <button type="button"
              class="btn btn-ghost btn-xs btn-circle text-base-content/40 hover:text-error"
              data-action="modal#close"
              aria-label="Close">
        ✕
      </button>
    </div>
    <%= render "shared/flash" %>
    <div class="mt-3 overflow-y-auto"> <%= content %> </div>
  </div>
</div>
